{
    "name": "crewmate",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace=@crewmate/web",
        "build": "npm run build --workspace=@crewmate/web",
        "start": "npm run start --workspace=@crewmate/web",
        "lint": "eslint --config apps/web/eslint.config.mjs apps/web/src packages",
        "typecheck": "tsc -p apps/web/tsconfig.json --noEmit --pretty false",
        "test": "node --test packages/*/src/*.test.ts",
        "check": "npm run lint && npm run typecheck && npm test",
        "check:all": "npm run check && npm run build"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.2.12",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "next": {
            "postcss": "8.5.24",
            "sharp": "0.35.3"
        }
    }
}
