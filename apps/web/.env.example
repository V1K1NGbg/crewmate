# NextAuth (openssl rand -base64 32)
AUTH_SECRET=randomly_generated_secret_key_here

# Google OAuth — fill in your credentials from https://console.cloud.google.com
GOOGLE_CLIENT_ID=google_client_id_here
GOOGLE_CLIENT_SECRET=google_client_secret_here

# App URL
NEXTAUTH_URL="http://localhost:3000"

# Home-server mode: use the deployment templates in deploy/ for Authelia setup.
# Google remains optional legacy mode when this is unset. Do not configure both
# providers as interchangeable owner identities.
# CREWMATE_AUTH_MODE=local
# AUTH_URL=https://<crewmate-private-host>
# AUTH_TRUST_HOST=true
# AUTH_OIDC_ISSUER=https://<identity-private-host>
# AUTH_OIDC_CLIENT_ID=crewmate
# AUTH_OIDC_CLIENT_SECRET=<server-side-secret>
# AUTH_OWNER_SUBJECT=<exact-oidc-subject-of-the-single-owner>
# CREWMATE_IDENTITY_URL=https://<identity-private-host>
# CREWMATE_PHOTOS_URL=https://<photos-private-host>
# CREWMATE_CONTAINERS_URL=https://<containers-private-host>
# CREWMATE_HOST_SOCKET=/run/crewmate-host/manager.sock
# CREWMATE_AI_URL=http://llama:8080/v1
# CREWMATE_AI_KEY=<optional-server-side-api-key>
