{
  "server": {"address": "tcp://:9091/"},
  "log": {"level": "info"},
  "authentication_backend": {
    "password_reset": {"disable": true},
    "password_change": {"disable": true},
    "file": {"path": "/config/users.yml"}
  },
  "access_control": {
    "default_policy": "deny",
    "rules": [{
      "domain": ["@CREWMATE_HOST@", "@PORTAINER_HOST@", "@IMMICH_HOST@"],
      "subject": ["user:@OWNER_USERNAME@"],
      "policy": "one_factor"
    }]
  },
  "session": {
    "name": "__Secure-crewmate_identity",
    "secret": "@AUTHELIA_SESSION_SECRET@",
    "expiration": "8h",
    "inactivity": "30m",
    "remember_me": "0",
    "cookies": [{
      "domain": "@COOKIE_DOMAIN@",
      "authelia_url": "https://@IDENTITY_HOST@",
      "default_redirection_url": "https://@CREWMATE_HOST@",
      "same_site": "lax"
    }]
  },
  "storage": {
    "encryption_key": "@AUTHELIA_STORAGE_KEY@",
    "local": {"path": "/data/db.sqlite3"}
  },
  "notifier": {"filesystem": {"filename": "/data/notification.txt"}},
  "identity_providers": {
    "oidc": {
      "hmac_secret": "@AUTHELIA_OIDC_HMAC_SECRET@",
      "jwks": [{"algorithm": "RS256", "use": "sig", "key": "@OIDC_PRIVATE_KEY@"}],
      "authorization_policies": {
        "owner": {"default_policy": "deny", "rules": [{"policy": "one_factor", "subject": "user:@OWNER_USERNAME@"}]}
      },
      "clients": [
        {
          "client_id": "@AUTH_OIDC_CLIENT_ID@",
          "client_name": "Crewmate",
          "consent_mode": "implicit",
          "client_secret": "@CREWMATE_OIDC_SECRET_HASH@",
          "public": false,
          "authorization_policy": "owner",
          "require_pkce": true,
          "pkce_challenge_method": "S256",
          "redirect_uris": ["https://@CREWMATE_HOST@/api/auth/callback/local"],
          "scopes": ["openid", "profile", "email"],
          "response_types": ["code"],
          "grant_types": ["authorization_code"],
          "access_token_signed_response_alg": "none",
          "userinfo_signed_response_alg": "none",
          "token_endpoint_auth_method": "client_secret_basic"
        },
        {
          "client_id": "@PORTAINER_OIDC_CLIENT_ID@",
          "client_name": "Portainer CE",
          "consent_mode": "implicit",
          "client_secret": "@PORTAINER_OIDC_SECRET_HASH@",
          "public": false,
          "authorization_policy": "owner",
          "require_pkce": false,
          "redirect_uris": ["https://@PORTAINER_HOST@"],
          "scopes": ["openid", "profile", "groups", "email"],
          "response_types": ["code"],
          "grant_types": ["authorization_code"],
          "access_token_signed_response_alg": "none",
          "userinfo_signed_response_alg": "none",
          "token_endpoint_auth_method": "client_secret_post"
        },
        {
          "client_id": "@IMMICH_OIDC_CLIENT_ID@",
          "client_name": "Immich browser",
          "consent_mode": "implicit",
          "client_secret": "@IMMICH_OIDC_SECRET_HASH@",
          "public": false,
          "authorization_policy": "owner",
          "require_pkce": true,
          "pkce_challenge_method": "S256",
          "redirect_uris": ["https://@IMMICH_HOST@/auth/login", "https://@IMMICH_HOST@/user-settings"],
          "scopes": ["openid", "profile", "email"],
          "response_types": ["code"],
          "grant_types": ["authorization_code"],
          "access_token_signed_response_alg": "none",
          "userinfo_signed_response_alg": "none",
          "token_endpoint_auth_method": "client_secret_basic"
        }
      ]
    }
  }
}
