{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

(tls_selected) {
	# configure.py emits this ONLY after TLS_MODE is explicitly selected.
	import /etc/caddy/tls.caddy
}

(owner_gate) {
	# No trusted_proxies wildcard: Caddy is the only edge, not behind another proxy.
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
	}
}

https://{$IDENTITY_HOST} {
	import tls_selected
	reverse_proxy authelia:9091
}

https://{$CREWMATE_HOST} {
	import tls_selected
	route {
		import owner_gate
		header Cache-Control "no-store"
		reverse_proxy crewmate:3000
	}
}

https://{$PORTAINER_HOST} {
	import tls_selected
	route {
		import owner_gate
		header {
			-X-Frame-Options
			Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors https://{$CREWMATE_HOST}; script-src 'self' https://js.hsforms.net https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; frame-src https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; form-action 'self' https://{$IDENTITY_HOST}"
			Cache-Control "no-store"
			X-Content-Type-Options nosniff
		}
		reverse_proxy portainer:9000 {
			header_down -X-Frame-Options
			header_down -Content-Security-Policy
			stream_timeout 5m
		}
	}
}

https://{$IMMICH_HOST} {
	import tls_selected
	route {
		import owner_gate
		header {
			-X-Frame-Options
			# A separate CSP adds a framing restriction without discarding Immich's CSP.
			+Content-Security-Policy "frame-ancestors https://{$CREWMATE_HOST}"
			Cache-Control "no-store"
		}
		reverse_proxy immich-server:2283 {
			header_down -X-Frame-Options
			stream_timeout 5m
		}
	}
}
