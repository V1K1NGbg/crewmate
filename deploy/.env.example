# Copy OUTSIDE the checkout to /etc/crewmate/deployment.env, chmod 600.
# Empty values are intentional deployment gates. No domain/CA/hardware is selected.
# Single-line KEY=value or KEY='literal value' only. Quote dollar-containing hashes.
CREWMATE_IMAGE=
CREWMATE_HOST=
IDENTITY_HOST=
PORTAINER_HOST=
IMMICH_HOST=
COOKIE_DOMAIN=
TLS_MODE=
# TLS_MODE must explicitly be internal or provided. provided requires these files:
# /etc/crewmate/certificates/fullchain.pem and /etc/crewmate/certificates/privkey.pem.
# All backends mount /etc/crewmate/certificates/trust.pem (public CA bundle,
# plus private root if explicitly chosen). Never disable certificate verification.
LAN_INTERFACE=
LAN_IP=
LAN_CIDR=
WG_SUBNET=
WG_PORT=
HOST_MANAGER_GID=
# Choose nonoverlapping IPv4 /29-or-larger networks after inspecting LAN/VM routes.
DASHBOARD_SUBNET=
IDENTITY_SUBNET=
ADMIN_SUBNET=
PHOTOS_PROXY_SUBNET=
AI_SUBNET=
EDGE_SUBNET=
PHOTOS_DATA_SUBNET=
PHOTOS_EGRESS_SUBNET=
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
AUTH_SECRET=
AUTH_OWNER_SUBJECT=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
CREWMATE_OIDC_SECRET_HASH=
PORTAINER_OIDC_CLIENT_ID=
PORTAINER_OIDC_SECRET_HASH=
IMMICH_OIDC_CLIENT_ID=
IMMICH_OIDC_SECRET_HASH=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_KEY=
AUTHELIA_OIDC_HMAC_SECRET=
# Budget values are required rather than pretending this laptop was measured.
CREWMATE_MEMORY=
CREWMATE_CPUS=
IMMICH_MEMORY=
IMMICH_CPUS=
IMMICH_ML_MEMORY=
IMMICH_ML_CPUS=
IMMICH_ML_THREADS=
DB_MEMORY=
DB_CPUS=
DB_PASSWORD=
LLAMA_MEMORY=
LLAMA_CPUS=
LLAMA_CONTEXT=
LLAMA_GPU_LAYERS=
LLAMA_THREADS=
MODEL_FILENAME=
# Optional API key; llama.cpp and Crewmate receive the SAME value.
CREWMATE_AI_KEY=
